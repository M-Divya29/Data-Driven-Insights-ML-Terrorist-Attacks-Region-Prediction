# Environment Configuration (Copy this to .env and fill in your values)
# DO NOT COMMIT .env FILE - Keep credentials private!

# API Keys
OPENROUTE_API_KEY=your_openroute_api_key_here
WEATHER_API_KEY=your_weather_api_key_here

# Model Download (Dropbox URL with token)
DROPBOX_MODEL_URL=your_dropbox_url_with_token_here

# Port Configuration
PORT=5000

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=False

# Database
DATABASE_URL=sqlite:///user_data.db
